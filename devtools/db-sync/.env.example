# Development only. Copy to .env beside the installed sync.py; never commit .env.
MYGANTT_SYNC_ENABLED=false
# Same random UUID on both peers. SSH keys authenticate; this ID prevents mispairing.
MYGANTT_SYNC_PAIR_ID=
# Absolute path to THIS machine's database. Required on both peers.
MYGANTT_SYNC_DB=
# Coordinator only. No default host, private path, or credentials are supplied.
MYGANTT_SYNC_SSH_HOST=
MYGANTT_SYNC_REMOTE_SCRIPT=
MYGANTT_SYNC_DELAY_SECONDS=300
